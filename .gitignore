# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (committed .env.example files document the contract)
.env*
!**/.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# ai: agent skills, skills-lock.json, and generated Convex guidelines are
# tracked on purpose so git worktrees and fresh clones get them. Only local
# Claude state (settings.local.json, worktrees/, lock files) stays ignored.
.claude/*
!.claude/settings.json
!.claude/skills/
/packages/backend/AGENTS.md
/packages/backend/CLAUDE.md
