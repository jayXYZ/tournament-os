# Copy to .env.local and fill in. Vite exposes VITE_* vars to the client.
# Full contract: docs/environment.md

# Convex — deployment URL (from `npx convex dev` in packages/backend)
VITE_CONVEX_URL=

# Clerk — same Clerk app as apps/native (https://docs.convex.dev/auth/clerk)
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Clerk routing (read by the Clerk SDK)
VITE_CLERK_SIGN_IN_URL=/sign-in
VITE_CLERK_SIGN_UP_URL=/sign-up
VITE_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
VITE_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# Sentry error monitoring (optional) — see docs/error-monitoring.md
VITE_SENTRY_DSN=
# Source-map upload (optional; activates only when SENTRY_AUTH_TOKEN is set)
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
