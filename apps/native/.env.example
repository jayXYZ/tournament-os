# Copy to .env.local and fill in. Expo exposes EXPO_PUBLIC_* vars to the client.
# Full contract: docs/environment.md

# Convex — use the SAME deployment URL as apps/web (.env.local VITE_CONVEX_URL)
EXPO_PUBLIC_CONVEX_URL=

# Clerk — publishable key from the same Clerk app the web app uses
# https://docs.expo.dev/guides/using-clerk/
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Sentry error monitoring (optional) — see docs/error-monitoring.md
EXPO_PUBLIC_SENTRY_DSN=
# Source-map/dSYM upload (optional; used by the Sentry Expo plugin at build time)
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
